#compdef nvidia-smi

# nvidia-smi has a wide option surface and no first-party completion file. Keep
# the tables flat and close to `nvidia-smi --help`/nvidia-smi(1) so future
# driver updates are mostly handled by editing data rather than control flow.
typeset -ga _NVIDIA_SMI_HELP_ARGS=(
  '(- *)'{-h,--help}'[Print usage information]'
)

# Top-level subcommands are centralized because new NVIDIA drivers add these
# more often than they change the core parser shape.
typeset -ga _NVIDIA_SMI_COMMANDS=(
  'dmon:Display device stats in scrolling format'
  'daemon:Monitor devices in the background'
  'replay:Replay or extract daemon logs'
  'pmon:Display process stats in scrolling format'
  'topo:Display device and system topology'
  'drain:Display or modify GPU drain states'
  'nvlink:Display device NVLink information'
  'c2c:Display device C2C information'
  'clocks:Control and query clock information'
  'encodersessions:Display encoder session information'
  'fbcsessions:Display FBC session information'
  'vgpu:Display vGPU information'
  'mig:Manage MIG instances'
  'compute-policy:Control and query compute policies'
