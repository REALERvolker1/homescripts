_nvidia-smi() {
  emulate -L zsh
  setopt EXTENDED_GLOB

  local curcontext="$curcontext" state command
  local -a line
  typeset -A opt_args

  # Let _arguments perform option parsing so command words after options are
  # identified consistently with the rest of compsys.
  _nvidia_smi__root_options

  case $state in
    command)
      _describe -t commands 'nvidia-smi command' _NVIDIA_SMI_COMMANDS
      ;;
    args)
      command=$line[1]

      case $command in
        dmon)
          _nvidia_smi__dmon
