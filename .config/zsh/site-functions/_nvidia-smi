_nvidia_smi__describe_entries() {
  emulate -L zsh

  local tag=$1 descr=$2 entry key
  shift 2
  local -a matches=()
  local -A seen=()

  # Several helpers combine live IDs with static placeholders. Deduping on the
  # inserted word keeps completion menus readable when sources overlap.
  for entry in "$@"; do
    [[ -n $entry ]] || continue
    key=${entry%%:*}
    [[ -n ${seen[$key]} ]] && continue
    seen[$key]=1
    matches+=("$entry")
  done

  (( $#matches )) || return 1
  _describe -t "$tag" "$descr" matches
}

_nvidia_smi__comma_values() {
  emulate -L zsh

  local helper=$1

  # nvidia-smi uses comma-separated words for IDs, query fields, and metric
  # groups. _sequence preserves normal compsys behavior for the current segment
  # and prevents already-entered values from being suggested again.
  _sequence -s , "$helper"
}

_nvidia_smi__integer() {
  emulate -L zsh

  # Numeric options are ranges or device-dependent values in NVIDIA help, so
  # _guard documents the shape without inventing false completions.
  _guard '[0-9]#' 'integer'
}

_nvidia_smi__number() {
  emulate -L zsh

  # Power limits and percentages can be decimal. A shape guard is safer than a
  # static range because valid bounds depend on the selected GPU.
  _guard '[0-9]#[.]?[0-9]#' 'number'
}

_nvidia_smi__time_hms() {
  emulate -L zsh

  # replay accepts either HH:MM:SS or 0 for file start/end. The common shapes
  # are useful hints, but arbitrary validation belongs to nvidia-smi itself.
  _message 'HH:MM:SS or 0'
}

_nvidia_smi__pci_id() {
  emulate -L zsh

  # Drain mode wants the PCI address instead of the broader GPU ID grammar.
  _message 'PCI ID in domain:bus:device.function form'
}

_nvidia_smi__gpu_ids() {
  emulate -L zsh

  local line
  local -a ids=()

  # Live GPU indexes and UUIDs are the most useful ID completions, but this
  # must fail quietly on machines where the NVIDIA driver is not loaded.
  if (( $+commands[nvidia-smi] )); then
    for line in "${(@f)$({ \nvidia-smi -L } 2>/dev/null)}"; do
      if [[ $line == (#b)GPU[[:space:]]##([0-9]##):* ]]; then
        ids+=("${match[1]}:GPU index")
      fi
      if [[ $line == *UUID:\ *\) ]]; then
        ids+=("${${line##*UUID: }%)}:GPU UUID")
      fi
    done
  fi

  _nvidia_smi__describe_entries gpu-ids 'GPU ID' "${ids[@]}" \
    '0:GPU index' 'GPU-:GPU UUID prefix' || _message 'GPU index, UUID, serial, or PCI bus ID'
}

_nvidia_smi__gpu_id_list() {
  emulate -L zsh

  # ID lists are common across root queries and subcommands, so one wrapper
  # keeps comma handling consistent.
  _nvidia_smi__comma_values _nvidia_smi__gpu_ids
}

_nvidia_smi__unit_ids() {
