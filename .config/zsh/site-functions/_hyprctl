#compdef hyprctl

_experimental_hyprctl__trim() {
  emulate -L zsh
  setopt extendedglob

  local text=$1

  # Help parsing repeats the same whitespace cleanup in several places. Keeping
  # it in one helper makes the parser tolerant of hyprctl's column alignment
  # without scattering extended-glob trimming patterns through the file.
  text=${text##[[:space:]]#}
  text=${text%%[[:space:]]#}
  REPLY=$text
}

_experimental_hyprctl__help() {
  emulate -L zsh

  # This experimental completer treats hyprctl itself as the source of truth.
  # It intentionally does not cache because the user requested live parsing and
  # hyprctl --help is cheap compared with the complexity of invalidation.
  \hyprctl "$@" --help 2>&1
}

_experimental_hyprctl__describe_entries() {
  emulate -L zsh

  local tag=$1 descr=$2 entry key
  shift 2
  local -a matches=()
  local -A seen=()

  # Parsed help can mention the same inserted word through aliases or repeated
  # sections. Deduping by the word before the description keeps menus compact.
  for entry in "$@"; do
    [[ -n $entry ]] || continue
    key=${entry%%:*}
    [[ -n ${seen[$key]} ]] && continue
    seen[$key]=1
    matches+=("$entry")
  done

  (( $#matches )) || return 1
  _describe -t "$tag" "$descr" matches
}

_experimental_hyprctl__section_entries() {
  emulate -L zsh
  setopt extendedglob

  # local text=$1 section=$2
  local arrow=$'\342\206\222'
  local line left desc
  local -i in_section=0
  local -a left_words
  reply=()

  # hyprctl help uses simple titled sections such as "commands:" and
  # "requests:". This parser only depends on those headings and the arrow
  # separator, so it survives changes to spacing and description wrapping.
  for line in "${(@f)1}"; do
    if [[ $line == "$2:" ]]; then
      in_section=1
      continue
    fi

    (( in_section )) || continue
    [[ -z $line ]] && continue

    # A new unindented heading ends the current section. This prevents "flags:"
    # text from being mistaken for command or request entries.
    if [[ $line != [[:space:]]* && $line == *: ]]; then
      break
    fi

    [[ $line == *$arrow* ]] || continue
    left=${line%%$arrow*}
    desc=${line#*$arrow}
    _experimental_hyprctl__trim "$left"
    left=$REPLY
    _experimental_hyprctl__trim "$desc"
    desc=$REPLY

    left_words=(${=left})
    left=$left_words[1]
    [[ -n $left ]] && reply+=("$left:$desc")
  done
}

_experimental_hyprctl__flag_entries() {
  emulate -L zsh
  setopt extendedglob

  local text=$1
  local arrow=$'\342\206\222'
  local line left desc
  local -i in_section=0
  local -a left_words
  reply=()

  # Flags have a slightly different shape from commands because aliases are
  # printed in parentheses, for example "--instance (-i)". This parser emits
  # each option spelling as its own completion candidate.
  for line in "${(@f)text}"; do
    if [[ $line == 'flags:' ]]; then
      in_section=1
      continue
    fi

    (( in_section )) || continue
    [[ -z $line ]] && continue
    if [[ $line != [[:space:]]* && $line == *: ]]; then
      break
    fi

    [[ $line == *$arrow* ]] || continue
    left=${line%%$arrow*}
    desc=${line#*$arrow}
    _experimental_hyprctl__trim "$left"
    left=$REPLY
    _experimental_hyprctl__trim "$desc"
    desc=$REPLY

    left_words=(${=left})
    for left in "$left_words[@]"; do
      left=${left//[()]/}
      [[ $left == -* ]] && reply+=("$left:$desc")
    done
  done
}

_experimental_hyprctl__usage_line() {
  emulate -L zsh

  local text=$1 line
  REPLY=

  # Usage lines are the only generic place where hyprctl exposes positional
  # argument names such as <icon> or <cmd>. Pulling out the first one keeps the
  # rest of the completer independent from individual commands.
  for line in "${(@f)text}"; do
    if [[ $line == usage:* ]]; then
      REPLY=$line
      return 0
    fi
  done

  return 1
}

_experimental_hyprctl__usage_placeholders() {
  emulate -L zsh
  setopt extendedglob

  local text=$1 command=$2 usage token after_command=0 cleaned
  local -a tokens
  reply=()

  _experimental_hyprctl__usage_line "$text" || return 1
  usage=$REPLY
  tokens=(${=usage})

  # The command name is the stable anchor in both "hyprctl [flags] cmd" and
  # "[flags] cmd" usage formats. Everything after it is inspected for bracketed
  # positional names.
  for token in "$tokens[@]"; do
    if (( ! after_command )); then
      [[ $token == $command ]] && after_command=1
      continue
    fi

    cleaned=${token//[<>\[\]|]/}
    cleaned=${cleaned//,/}
    [[ -n $cleaned && $cleaned != flags && $cleaned != command && $cleaned != args... && $cleaned != --help ]] || continue
    reply+=("$cleaned")
  done
}

_experimental_hyprctl__usage_alternatives() {
  emulate -L zsh
  setopt extendedglob

  local text=$1 command=$2 usage after_command alt first cleaned
  local -a alternatives alt_words
  reply=()

  _experimental_hyprctl__usage_line "$text" || return 1
  usage=$REPLY
  after_command=${usage#*$command}
  [[ $after_command == *'|'* ]] || return 1

  # Some hyprctl commands encode a small request set directly in usage, e.g.
  # "output <create <backend> | remove <name>>", without a requests section.
  # Splitting on "|" and taking the first word of each branch recovers those
  # literal requests while staying generic enough for similar future help text.
  alternatives=("${(@s:|:)after_command}")
  for alt in "$alternatives[@]"; do
    _experimental_hyprctl__trim "$alt"
    alt=$REPLY
    alt_words=(${=alt})
    first=$alt_words[1]
    cleaned=${first//[<>\[\]|]/}
    cleaned=${cleaned//,/}
    [[ -n $cleaned && $cleaned != flags && $cleaned != args... && $cleaned != --help ]] || continue
    reply+=("$cleaned")
  done

  (( $#reply ))
}

_experimental_hyprctl__usage_alternative_placeholder() {
  emulate -L zsh
  setopt extendedglob

  local text=$1 command=$2 request=$3 arg_index=$4
  local usage after_command alt first token
  local -a alternatives alt_words
  REPLY=

  _experimental_hyprctl__usage_line "$text" || return 1
  usage=$REPLY
  after_command=${usage#*$command}
  [[ $after_command == *'|'* ]] || return 1

  # After a usage-derived request has been typed, use that same branch to name
  # the next positional argument. This is why "output remove <TAB>" says "name"
  # while "output create <TAB>" says "backend".
  alternatives=("${(@s:|:)after_command}")
  for alt in "$alternatives[@]"; do
    _experimental_hyprctl__trim "$alt"
    alt=$REPLY
    alt_words=(${=alt})
    first=${alt_words[1]//[<>\[\]|]/}
    first=${first//,/}
    [[ $first == $request ]] || continue

    token=$alt_words[$(( arg_index + 1 ))]
    token=${token//[<>\[\]|]/}
    token=${token//,/}
    REPLY=$token
    [[ -n $REPLY ]] && return 0
  done

  return 1
}

_experimental_hyprctl__request_placeholder() {
  emulate -L zsh
  setopt extendedglob

  local text=$1 request=$2 arg_index=$3
  local arrow=$'\342\206\222'
  local line left token in_section=0
  local -a left_words
  REPLY=

  # Some commands describe nested requests as "name <arg>" inside the requests
  # section. Reading that shape lets the completer show the next argument name
  # without hard-coding plugin, hyprsunset, or future request families.
  for line in "${(@f)text}"; do
    if [[ $line == 'requests:' ]]; then
      in_section=1
      continue
    fi

    (( in_section )) || continue
    [[ -z $line ]] && continue
    if [[ $line != [[:space:]]* && $line == *: ]]; then
      break
    fi

    [[ $line == *$arrow* ]] || continue
    left=${line%%$arrow*}
    _experimental_hyprctl__trim "$left"
    left=$REPLY
    left_words=(${=left})
    [[ $left_words[1] == $request ]] || continue

    token=$left_words[$(( arg_index + 1 ))]
    token=${token//[<>\[\]|]/}
    token=${token//,/}
    REPLY=$token
    [[ -n $REPLY ]] && return 0
  done

  return 1
}

_experimental_hyprctl__command_before_cursor() {
  emulate -L zsh

  local i word skip_next=0
  reply=()

  # Completion has to find the first non-flag word before the cursor because
  # global flags may precede the command. Only options documented as taking a
  # value are skipped with their following word.
  for (( i = 2; i < CURRENT; i++ )); do
    word=$words[i]

    if (( skip_next )); then
      skip_next=0
      continue
    fi

    case $word in
      --batch|--instance|-i)
        skip_next=1
        ;;
      --*)
        ;;
      -*)
        ;;
      *)
        reply=("$word" "$i")
        return 0
        ;;
    esac
  done

  return 1
}

_experimental_hyprctl__complete_flags() {
  emulate -L zsh

  local text=$1
  local -a flags

  # Subcommand help often says "See 'hyprctl --help'" instead of repeating the
  # flag table. The caller can retry with root help if this returns no matches.
  _experimental_hyprctl__flag_entries "$text"
  flags=("$reply[@]")
  _experimental_hyprctl__describe_entries options 'hyprctl option' "$flags[@]"
}

_experimental_hyprctl__complete_placeholder() {
  emulate -L zsh

  local text=$1 placeholder=$2
  local -a entries

  # A placeholder named "request" maps directly to a requests section. Other
  # placeholders first try a same-named section, then fall back to a message so
  # the user still sees the argument expected by the current help text.
  case $placeholder in
    request)
      _experimental_hyprctl__section_entries "$text" requests
      entries=("$reply[@]")
      _experimental_hyprctl__describe_entries requests request "$entries[@]"
      ;;
    path)
      _files
      ;;
    icon|cmd|device|color)
      _experimental_hyprctl__section_entries "$text" "$placeholder"
      entries=("$reply[@]")
      _experimental_hyprctl__describe_entries "$placeholder" "$placeholder" "$entries[@]" || _message "$placeholder"
      ;;
    time_ms|time|amount|size|temp|gamma)
      _guard '[0-9]#' "$placeholder"
      ;;
    *)
      _message "$placeholder"
      ;;
  esac
}

_experimental_hyprctl_completions() {
  emulate -L zsh

  local root_help command command_index command_help arg_index request placeholder
  local -a entries flags placeholders

  root_help=$(_experimental_hyprctl__help)

  # Value-bearing global flags are handled before command discovery so
  # "--instance <TAB>" and "--batch <TAB>" do not get mistaken for command
  # position.
  case $words[CURRENT-1] in
    --instance|-i)
      _message 'instance signature or index'
      return
      ;;
    --batch)
      _message "commands separated by ';'"
      return
      ;;
  esac

  if ! _experimental_hyprctl__command_before_cursor; then
    if [[ $PREFIX == -* ]]; then
      _experimental_hyprctl__complete_flags "$root_help"
      return
    fi

    _experimental_hyprctl__section_entries "$root_help" commands
    entries=("$reply[@]")
    _experimental_hyprctl__describe_entries commands 'hyprctl command' "$entries[@]"
    return
  fi

  command=$reply[1]
  command_index=$reply[2]
  command_help=$(_experimental_hyprctl__help "$command")
  arg_index=$(( CURRENT - command_index ))

  # Once a command is known, option completion is driven by that command's help
  # first. If it delegates flags to the root help, retry with root help.
  if [[ $PREFIX == -* ]]; then
    _experimental_hyprctl__complete_flags "$command_help" || _experimental_hyprctl__complete_flags "$root_help"
    return
  fi

  if (( arg_index == 1 )); then
    _experimental_hyprctl__section_entries "$command_help" requests
    entries=("$reply[@]")
    if (( $#entries )); then
      _experimental_hyprctl__describe_entries requests request "$entries[@]"
      return
    fi

    _experimental_hyprctl__usage_alternatives "$command_help" "$command"
    entries=("$reply[@]")
    if (( $#entries )); then
      _experimental_hyprctl__describe_entries requests request "$entries[@]"
      return
    fi
  fi

  request=$words[$(( command_index + 1 ))]
  if (( arg_index > 1 )) && _experimental_hyprctl__request_placeholder "$command_help" "$request" $(( arg_index - 1 )); then
    placeholder=$REPLY
    _experimental_hyprctl__complete_placeholder "$command_help" "$placeholder"
    return
  fi

  if (( arg_index > 1 )) && _experimental_hyprctl__usage_alternative_placeholder "$command_help" "$command" "$request" $(( arg_index - 1 )); then
    placeholder=$REPLY
    _experimental_hyprctl__complete_placeholder "$command_help" "$placeholder"
    return
  fi

  _experimental_hyprctl__usage_placeholders "$command_help" "$command"
  placeholders=("$reply[@]")
  placeholder=$placeholders[$arg_index]

  if [[ -n $placeholder ]]; then
    _experimental_hyprctl__complete_placeholder "$command_help" "$placeholder"
  else
    _message 'argument'
  fi
}

compdef _experimental_hyprctl_completions hyprctl
