[Unit]
Description=Automatic i3 tiling
PartOf=xorg.target graphical-session.target
After=graphical-session.target
ConditionEnvironment=I3SOCK
ConditionFileIsExecutable=/usr/bin/autotiling-rs
[Service]
Type=simple
Restart=on-failure
RestartSec=3s
ExecStart=/usr/bin/autotiling-rs
Slice=app.slice

[Install]
WantedBy=xorg.target
