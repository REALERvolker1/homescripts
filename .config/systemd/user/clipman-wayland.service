[Unit]
Description=Store Wayland clipboard text
PartOf=wayland.target graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Restart=on-failure
RestartSec=3s
ExecStart=/usr/bin/wl-paste -t text --watch clipman store --histpath=%t/virus.bin
Slice=app.slice

[Install]
WantedBy=wayland.target
